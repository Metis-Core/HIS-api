NODE_ENV=development
PORT=8000
# Comma-separated list of allowed web origins (required in production)
CORS_ORIGINS=http://localhost:4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=his
# Local development only; refused when NODE_ENV=production
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=false

# Generate each with: openssl rand -base64 48 (minimum 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limits for /auth/login, /auth/change-password and /otp/* per client IP + account (requests per window; successful attempts count too)
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_SECONDS=60

# Only read by `npm run user:create-admin` and `npm run user:seed`
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limits see the real client IP
TRUST_PROXY=
# Lab attachments (L8): a persistent, backed-up folder outside the deploy directory; max upload size in bytes (default 10 MB)
ATTACHMENTS_DIR=
ATTACHMENT_MAX_BYTES=10485760
